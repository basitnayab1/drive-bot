# Server Port
PORT=3000

# Optional: Path to Google Service Account JSON file (default: ./google-credentials.json)
GOOGLE_CREDENTIALS_PATH=google-credentials.json

# Optional: Default Google Drive Folder ID to upload client files into
# Open your Google Drive folder in browser, the ID is the long string at the end of the URL
GOOGLE_DRIVE_FOLDER_ID=

# Admin Dashboard Password (Optional for protection)
ADMIN_PASSWORD=admin123
